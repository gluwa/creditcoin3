# -- Wallet connection ---------------------------------------------------------
# WalletConnect Cloud project id, required by RainbowKit even when only using injected wallets.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=""

# -- Chain RPCs ------------------------------------------------------------------
NEXT_PUBLIC_ETH_SEPOLIA_RPC_URL="https://ethereum-sepolia-rpc.publicnode.com"
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# -- Contract addresses ----------------------------------------------------------
# One BridgeVault + registry chain key per spoke. Chain keys below match usc-bridge-deploy.json's
# `spokes` map (§4 of the bridge POC plan) — NOT the EVM chain id.
NEXT_PUBLIC_ETH_SEPOLIA_CHAIN_KEY="8"
NEXT_PUBLIC_ETH_SEPOLIA_BRIDGE_VAULT_ADDRESS=""
NEXT_PUBLIC_BASE_SEPOLIA_CHAIN_KEY=""
NEXT_PUBLIC_BASE_SEPOLIA_BRIDGE_VAULT_ADDRESS=""

# (Optional) Block each BridgeVault was deployed at — the floor for History's chain-log scan, so a
# fresh browser doesn't scan from block 0 across millions of blocks (use-bridge-history.ts). Find
# it once with a binary search on eth_getCode, or just use the BridgeVault deployment tx's block.
NEXT_PUBLIC_ETH_SEPOLIA_VAULT_GENESIS_BLOCK=""
NEXT_PUBLIC_BASE_SEPOLIA_VAULT_GENESIS_BLOCK=""

# (Optional) This spoke's shared DispatcherRouter address (same one BridgeVault trusts as its
# Inbox — readable as that chain's `Inbox.messageDispatcher()`). Only used by the progress screen
# and the Inspect page to detect a terminal `DestinationDeliveryFailed` delivery; without it, a
# failed delivery just looks stuck at "released" forever instead of showing why.
NEXT_PUBLIC_ETH_SEPOLIA_ROUTER_ADDRESS=""
NEXT_PUBLIC_BASE_SEPOLIA_ROUTER_ADDRESS=""

# -- proof-gen-api-server ---------------------------------------------------------
# Public base URL; the browser polls GET /api/v1/attested-height/{chainKey} directly (the service
# ships CorsLayer::allow_origin(Any) — no backend proxy needed, see progress/page.tsx).
NEXT_PUBLIC_PROOF_GEN_URL=""

# -- Creditcoin (hub) — optional, read-only ---------------------------------------
# Only used for the progress screen's best-effort "claimed on Creditcoin" step (reading
# BridgeHub.Claimed to learn the release messageId). The dApp never asks a user to connect a
# wallet to Creditcoin — this is a plain read-only RPC call, not a wagmi chain. Left unset, the
# progress screen skips straight from "attested" to scanning the destination for the release.
NEXT_PUBLIC_CREDITCOIN_CHAIN_ID="42"
NEXT_PUBLIC_CREDITCOIN_RPC_URL=""
NEXT_PUBLIC_BRIDGE_HUB_ADDRESS=""
