# Proof Gen API Server environment variable examples
# Copy this file to .env and adjust values as needed.
# DO NOT commit your personal .env.

# Note: The HTTP API server bind address is configured via CLI flags:
#   --bind-host (default: 0.0.0.0)
#   --bind-port (default: 3100)
#
# Multi-chain YAML config (optional). When set, `chains:` in the file replace
# single-chain ETH_RPC_URL / CHAIN_KEY / ARCHIVER_URL below.
PROOF_GEN_CONFIG_FILE=./config.yaml

# Creditcoin3 RPC (WebSocket). Not in config.yaml; set here or pass --cc3-rpc-url (CLI overrides env).
CC3_RPC_URL=wss://rpc.usc-devnet.creditcoin.network

# Mnemonic or seed phrase used by server for chain interactions
# Use development accounts (e.g., //Alice) in local and devnet environments. Do NOT use in production.
CC3_KEY=//Alice

# Logging profile; set to production OR prod in real deployments
RUST_LOG=debug

# Enable Prometheus metrics collection
ENABLE_PROMETHEUS_METRICS=false
PROMETHEUS_HOST=0.0.0.0
PROMETHEUS_PORT=9090

# [DEPRECATED — ignored] Block caching is in-process only; these are no longer read.
# Size the in-process caches with each chain's `cache:` block in the YAML config instead.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_CLUSTER_MODE=false

# [DEPRECATED — ignored] The indexer is no longer used; this setting has no effect.
# INDEXER_URL=http://127.0.0.1:3000

# Notes:
# - Never commit real mnemonics or secrets.

# Amount of concurrent futures spawned when generating proofs for batch requests or when extracting transaction indexes from transaction hashes.
# This will limited the maximum amount of parallel RPC calls made for a single API request, which can help prevent overwhelming the RPC endpoint and hitting rate limits.
# Adjust based on expected load and RPC rate limits.
MAX_BATCH_SIZE=10

# Number of blocks to lag behind the EVM chain tip when validating block existence.
# Blocks within this window are rejected to guard against reorgs.
# When UNSET (recommended), this is derived from the chain's on-chain MaturityStrategy -- the
# same value the attestors act on, so this process cannot disagree with them. Set it only to
# deliberately pin a value; startup warns if it disagrees with the chain.
# Note: in --config (YAML) mode this env var is ignored; use the per-chain
# `block_confirmation_depth` field instead.
# BLOCK_CONFIRMATION_DEPTH=32

# Per-chain cache sizing (merkle_retention_blocks, merkle_max_bytes, block_cache_capacity,
# merkle_backfill_enabled, checkpoint_cache_max_entries) is expressed only in the YAML config,
# under each chain's `cache:` block. See config.example.yaml.
