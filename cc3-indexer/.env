# Target host.docker.interal for development
# ENDPOINT=ws://host.docker.internal:9944/
ENDPOINT=wss://rpc.cc3-devnet.creditcoin.network

# Chain id is the genesis hash of the chain
CHAIN_ID=0xbdb995ee19296026814960ba3b983e8e05784644baf0a5676eb2b5759203ec27

# USC write-ability needs no configuration: OutboxFactory + Outbox contracts are discovered on-chain
# (supportedChains.OutboxFactoryRegistered → factory's OutboxCreated) and indexed via dynamic
# datasources. On networks where no factory is ever registered, those datasources simply never spawn.
