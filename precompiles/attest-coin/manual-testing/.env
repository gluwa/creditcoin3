# Local dev configuration for the attest-coin manual test walkthrough.
#
# Every key below is a well-known public development credential, so this file is
# checked in on purpose. Never point these scripts at a network you care about.

# Creditcoin's embedded EVM. Same port as the Substrate RPC — the node serves
# both. This is where the attest-coin ERC-20 and the precompiles live; anvil on
# :8545 is only the source chain being attested.
CC3_RPC_URL=http://127.0.0.1:9944

# "Alith", pre-funded with 1,000,000 CTC in the --dev chainspec. Deploys the
# ERC-20 and therefore becomes its only minter, so step 5's ATC funding has to
# be signed with this same key.
# https://docs.moonbeam.network/builders/get-started/networks/moonbeam-dev/#pre-funded-development-accounts
DEPLOYER_PRIVATE_KEY=0x5fb92d6e98884f76de468fa3f6278f8807c48bebc13595d45af5bdc4da702133

# WebSocket endpoints for the attestor. It needs ws:// for both — the Creditcoin
# node serves ws on the same port as http, and anvil does too.
CC3_WS_URL=ws://127.0.0.1:9944
ANVIL_WS_URL=ws://127.0.0.1:8545

# Chain being attested. 2 == "Anvil1" (chain id 31337) in the --dev chainspec's
# supported-chains genesis, matching the anvil instance from step 1.
CHAIN_KEY=2

# Filled in by deploy-erc20.js. Steps 4 and 5 need this address.
ATTESTCOIN_ERC20=
# The attestor stash. Generated by scripts/new-stash.js — a fresh account so the
# step 14 accounting starts from zero. Its mapped Substrate account (what the
# pallet bonds from) is blake2_256("evm:" || STASH_ADDRESS); new-stash.js prints
# the SS58 form.
STASH_ADDRESS=
STASH_PRIVATE_KEY=

# Attestor operator account (sr25519), from `subkey generate`.
ATTESTOR_SS58=
ATTESTOR_SEED=
